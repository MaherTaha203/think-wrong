; THINK WRONG — Godot 4.3 project configuration.
; Premium offline mobile lateral-thinking puzzle prototype. Independent of the
; ONE LINE project; shares no runtime code with it.

config_version=5

[application]

config/name="THINK WRONG"
config/description="A premium offline lateral-thinking puzzle prototype. The obvious solution is usually wrong."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/icon.svg"

[autoload]

Versions="*res://scripts/core/versions.gd"
Localization="*res://scripts/i18n/localization.gd"
SaveManager="*res://scripts/persistence/save_manager.gd"
GameState="*res://scripts/state/game_state.gd"
AudioManager="*res://scripts/services/audio_manager.gd"
Haptics="*res://scripts/services/haptics.gd"
ScreenManager="*res://scripts/ui/screen_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[input_devices]

; Godot's Button/Control GUI reacts to mouse events only. On phones the OS
; delivers InputEventScreenTouch, so touch MUST be translated into mouse events
; or no button ever responds (verified by tests/visual/qa_tour). Buttons ignore
; the raw touch event, so this never double-fires. The reverse (mouse -> touch)
; stays off: desktop QA uses the native mouse.
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
