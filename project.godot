; THINK WRONG — Godot 4.3 project configuration.
; Premium offline mobile lateral-thinking puzzle prototype. Independent of the
; ONE LINE project; shares no runtime code with it.

config_version=5

[application]

config/name="THINK WRONG"
config/description="A premium offline lateral-thinking puzzle prototype. The obvious solution is usually wrong."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/icon.svg"

[autoload]

Versions="*res://scripts/core/versions.gd"
Localization="*res://scripts/i18n/localization.gd"
SaveManager="*res://scripts/persistence/save_manager.gd"
GameState="*res://scripts/state/game_state.gd"
AudioManager="*res://scripts/services/audio_manager.gd"
Haptics="*res://scripts/services/haptics.gd"
ScreenManager="*res://scripts/ui/screen_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="portrait"

[input_devices]

; Native touch (mobile) and native mouse (desktop) are handled directly by the
; UI; emulation is disabled so events never double-fire.
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
